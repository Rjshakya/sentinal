# Copy to .env and fill in. Loaded by the API (pydantic-settings) and by Alembic.

# Async SQLAlchemy URL. The driver is asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicode

# JSON array of allowed origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]

# URL prefix for all API routes.
API_PREFIX=/api


# ---------------------------------------------------------------------------
# WorkOS (user sign-in)
# ---------------------------------------------------------------------------
# WorkOS handles sign-in (Google / GitHub OAuth). The sealed session
# cookie identifies the user. The Pipes surface (previously used for
# GitHub OAuth) has been removed; the GitHub integration is now a
# native GitHub App, see the section below.

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
WORKOS_COOKIE_PASSWORD=
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=wos_session


# ---------------------------------------------------------------------------
# Sandbox provider
# ---------------------------------------------------------------------------
# SANDBOX_PROVIDER selects the active provider tag ('e2b' or 'daytona').
# The factory in `app.core.sandbox.factory` reads this to build the
# SandboxSpec; the indexing pipeline only ever sees a BaseSandbox.

SANDBOX_PROVIDER=e2b

# E2B
E2B_API_KEY=
# code-interpreter-v1 is the E2B-hosted template (no build required).
# Replace with a custom template slug to use a pre-baked image.
E2B_TEMPLATE=code-interpreter-v1
E2B_CPU_COUNT=2
E2B_MEMORY_MB=2048
E2B_TIMEOUT_S=1200

# Daytona
DAYTONA_API_KEY=
DAYTONA_TEMPLATE=


# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# Register the App at https://github.com/settings/apps/new. The slug is
# the human-readable URL segment. The private key must be the PEM
# from the App's "Private keys" section; newlines may be encoded as
# the literal sequence '\n' in this env var.
#
# All four required fields must be set for GitHub routes to work.
# Leave blank to disable the GitHub integration locally.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# GitHub webhook
# ---------------------------------------------------------------------------
# Shared secret used to verify GitHub webhook deliveries via the
# X-Hub-Signature-256 header. Configure the same value in the App's
# webhook settings (Permissions & events -> Webhook -> Secret).
# Leave empty to reject all webhook deliveries.
GITHUB_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# When true, every LLM call (and every tool invocation) made by the
# review agents is logged as a structured JSON line via
# app.core.llm_callbacks.LLMIOCallbackHandler. Each line carries the
# per-call input (truncated to 8 KB per field), output, usage
# metadata, and correlation context (agent / repo / pr / head_sha /
# workflow_id). Leave false in production; flip on in dev to debug
# agent behavior.
# LLM_LOG_IO=false

