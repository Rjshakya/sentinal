# Copy to .env and fill in. Loaded by the API (pydantic-settings) and by Alembic.

# Async SQLAlchemy URL. The driver is asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicode

# JSON array of allowed origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]

# URL prefix for all API routes.
API_PREFIX=/api


# ---------------------------------------------------------------------------
# WorkOS (user sign-in)
# ---------------------------------------------------------------------------
# WorkOS handles sign-in (Google / GitHub OAuth). The sealed session
# cookie identifies the user. The Pipes surface (previously used for
# GitHub OAuth) has been removed; the GitHub integration is now a
# native GitHub App, see the section below.

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
WORKOS_COOKIE_PASSWORD=
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=wos_session


# ---------------------------------------------------------------------------
# Sandbox provider
# ---------------------------------------------------------------------------
# SANDBOX_PROVIDER selects the active provider tag ('e2b' or 'daytona').
# The factory in `app.core.sandbox.factory` reads this to build the
# SandboxSpec; the indexing pipeline only ever sees a BaseSandbox.

SANDBOX_PROVIDER=e2b

# E2B
E2B_API_KEY=
# code-interpreter-v1 is the E2B-hosted template (no build required).
# Replace with a custom template slug to use a pre-baked image.
E2B_TEMPLATE=code-interpreter-v1
E2B_CPU_COUNT=2
E2B_MEMORY_MB=2048
E2B_TIMEOUT_S=1200

# Daytona
DAYTONA_API_KEY=
DAYTONA_TEMPLATE=


# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# Register the App at https://github.com/settings/apps/new. The slug is
# the human-readable URL segment. The private key must be the PEM
# from the App's "Private keys" section; newlines may be encoded as
# the literal sequence '\n' in this env var.
#
# All four required fields must be set for GitHub routes to work.
# Leave blank to disable the GitHub integration locally.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"


# ---------------------------------------------------------------------------
# GitHub webhook
# ---------------------------------------------------------------------------
# Shared secret used to verify GitHub webhook deliveries via the
# X-Hub-Signature-256 header. Configure the same value in the App's
# webhook settings (Permissions & events -> Webhook -> Secret).
# Leave empty to reject all webhook deliveries.
GITHUB_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# LLM (review agent)
# ---------------------------------------------------------------------------
# LLM_MODEL is a "provider:model" string consumed by LangChain's
# init_chat_model. Examples (per the Deep Agents suggested-models
# table):
#   LLM_MODEL=openai:gpt-5.5
#   LLM_MODEL=openai:gpt-5.4
#   LLM_MODEL=anthropic:claude-opus-4-6
#   LLM_MODEL=google_genai:gemini-3.6-flash
# For OpenAI-compatible proxies / gateways (Cloudflare AI Gateway,
# OpenCode Zen, Baseten, OpenRouter, Ollama, …) also set
# LLM_BASE_URL and LLM_API_KEY; the provider prefix in LLM_MODEL
# stays the same.
#
# When LLM_API_KEY is blank, the active provider's native env-var
# resolution is used (OPENAI_API_KEY / ANTHROPIC_API_KEY /
# GOOGLE_API_KEY / …).
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Optional. JSON-encoded dict attached to every request — gateway
# identifiers, project tags, per-tenant routing hints. Forwarded
# as `default_headers` to providers that accept the kwarg; ignored
# by providers that don't.
LLM_DEFAULT_HEADERS={}
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_RPS=0.5


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Telemetry (OpenLLMetry — traceloop-sdk) centralises traces and logs
# on OpenTelemetry and exports both over OTLP, so any collector can
# ingest them. When both vars below are empty the SDK is never
# initialised and all logs stay on the console.
# The SDK auto-instruments LangChain + the provider SDKs, so every LLM
# call of the review agents (both lanes + extractors) becomes a gen_ai
# span; the FastAPI app gets one HTTP span per request
# (opentelemetry-instrumentation-fastapi); each review run is grouped
# under one `review` workflow span tagged with repo/pr/head/user.
#
# Leave TRACELOOP_BASE_URL and TRACELOOP_API_KEY both empty to disable
# telemetry entirely (the SDK is never initialised).
#
# TRACELOOP_BASE_URL is the OTLP/HTTP endpoint; the SDK appends
# /v1/traces. An http(s) prefix selects OTLP/HTTP. Works with any OTLP
# backend (Traceloop Cloud, a self-hosted OpenTelemetry collector,
# Langfuse/Axiom/Grafana OTLP endpoints, …).
TRACELOOP_BASE_URL=
# Bearer token for the OTLP endpoint (required for Traceloop Cloud,
# optional for self-hosted collectors).
TRACELOOP_API_KEY=
# Capture prompts / completions / embeddings as span attributes.
# True gives full visibility into what the review agents sent and
# received; false keeps message bodies out of the traces.
TRACELOOP_TRACE_CONTENT=true
# Send spans immediately instead of batching. Handy in dev to see
# traces in real time; leave false in production.
TRACELOOP_DISABLE_BATCH=false
# Instrument the FastAPI app (one HTTP span per request) when
# telemetry is configured.
TELEMETRY_FASTAPI=true

