# Copy to .env and fill in. Loaded by the API (pydantic-settings) and by Alembic.

# Async SQLAlchemy URL. The driver is asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicode

# JSON array of allowed origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]

# URL prefix for all API routes.
API_PREFIX=/api

# --- WorkOS User Management ---
# Create a project + User Management instance at https://dashboard.workos.com
# Add GoogleOAuth + GitHubOAuth as social connections in the WorkOS dashboard.
# Set the redirect URI in WorkOS to exactly WORKOS_REDIRECT_URI below.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=

# 32+ random characters (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# Used by WorkOS SDK to seal the session cookie. Rotation invalidates all sessions.
WORKOS_COOKIE_PASSWORD=
# Where to send the browser after a successful login. The callback 302s here
# after setting the sealed session cookie.
FRONTEND_URL=http://localhost:3000

# --- Sandbox (E2B) ---
E2B_API_KEY=
E2B_TEMPLATE=code-interpreter-v1

# --- Indexing pipeline ---
# OpenAI key used by the in-sandbox LanceDB embedding function
# (``text-embedding-3-large``). Read on the host and forwarded into
# the indexing sandbox via the step's envs= kwarg.
OPENAI_API_KEY=
# S3 bucket the indexing pipeline writes its LanceDB datasets to.
# Required for the indexing pipeline to run end-to-end.
INDEX_S3_BUCKET=
# Default = "sentinel/lance"
INDEX_S3_PREFIX=sentinel/lance

# --- AWS (consumed on the host by resolve_index_env, then forwarded into the indexing sandbox via envs=) ---
# All four are required by the indexing pipeline. Missing any one raises
# IndexingConfigError at step time.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Default = "us-east-1"
AWS_REGION=us-east-1
# Required for non-AWS S3 (MinIO, R2, etc.). Include scheme, e.g. https://<account>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=

# --- LLM (review agent) ---
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_HEADERS={}
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_RPS=0.5
